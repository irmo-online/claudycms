# ─── PHP-Ausführung verbieten (Tiefenstaffelung, L12) ───────────────────────
# Hochgeladene Bilder werden vor dem Speichern validiert (lib/media.php,
# cms_validate_image_upload() prueft den echten Bildinhalt, nicht nur die
# Endung) — eine PHP-Datei sollte diesen Ordner also nie erreichen. Diese
# Regel ist die zweite Verteidigungslinie, falls die Validierung doch einmal
# umgangen wird: selbst eine als Bild getarnte .php-Datei wird hier nicht mehr
# ausgefuehrt, nur noch als Datei ausgeliefert.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.ph(p[3457]?|t|tml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
